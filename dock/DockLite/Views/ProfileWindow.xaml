<Window x:Class="DockLite.Views.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DockPolice — Mon profil annuaire"
        Icon="pack://application:,,,/Assets/DockPolice.ico"
        Width="620" Height="640"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F19"
        Foreground="#E6EAF2"
        FontFamily="Segoe UI"
        FontSize="13"
        ResizeMode="NoResize">

    <Window.Resources>
        <SolidColorBrush x:Key="Bg1"     Color="#121829"/>
        <SolidColorBrush x:Key="Bg2"     Color="#1A2137"/>
        <SolidColorBrush x:Key="Border"  Color="#2A3350"/>
        <SolidColorBrush x:Key="Text"    Color="#E6EAF2"/>
        <SolidColorBrush x:Key="TextDim" Color="#96A1C0"/>
        <SolidColorBrush x:Key="TextMuted" Color="#6C7690"/>
        <SolidColorBrush x:Key="Primary" Color="#4E8BFF"/>
        <SolidColorBrush x:Key="Success" Color="#10B981"/>
        <SolidColorBrush x:Key="Locked"  Color="#3A4566"/>

        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style TargetType="TextBox" x:Key="Field">
            <Setter Property="Background" Value="{StaticResource Bg2}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style TargetType="TextBox" x:Key="LockedField" BasedOn="{StaticResource Field}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#0F1525"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Locked}"/>
        </Style>

        <!-- Style ComboBoxItem : fond sombre, hover et sélection visibles -->
        <Style TargetType="ComboBoxItem" x:Key="ComboItem">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="{StaticResource Bg2}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="0,0,0,1" BorderBrush="#1F2A44">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#26345C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2D3D63"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style ComboBox : champ + popup foncés, lisibles -->
        <Style TargetType="ComboBox" x:Key="Combo">
            <Setter Property="Background" Value="{StaticResource Bg2}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="MainBorder" Grid.ColumnSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3"/>
                            <ContentPresenter Grid.Column="0"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              IsHitTestVisible="False"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <ToggleButton Grid.Column="1" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="Transparent" BorderBrush="Transparent">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <Path HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Data="M 0 0 L 8 0 L 4 5 Z" Fill="#96A1C0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" AllowsTransparency="True"
                                   PopupAnimation="Slide" StaysOpen="False">
                                <Border Background="{StaticResource Bg2}"
                                        BorderBrush="{StaticResource Border}"
                                        BorderThickness="1" CornerRadius="3"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="320">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource Primary}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource Primary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                <Setter TargetName="MainBorder" Property="Background" Value="#0F1525"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="Btn">
            <Setter Property="Background" Value="{StaticResource Bg2}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="Button" x:Key="PrimaryBtn" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="{StaticResource Primary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0F1730" Padding="22,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="MON PROFIL ANNUAIRE" Foreground="{StaticResource TextMuted}"
                               FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtHeader" Text="Bienvenue" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtSubHeader" Foreground="{StaticResource TextDim}"
                               FontSize="12" Margin="0,4,0,0"
                               Text="Vos informations alimentent l'annuaire interne du service informatique."/>

                    <!-- Barre de complétude profil -->
                    <Grid Margin="0,12,0,0" MaxWidth="500" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="TxtCompletenessLabel"
                                   Foreground="{StaticResource TextDim}" FontSize="11"
                                   Text="Complétude de votre fiche : —"/>
                        <TextBlock Grid.Column="1" x:Name="TxtCompletenessPct"
                                   Foreground="#10B981" FontSize="11" FontWeight="SemiBold"
                                   Text="0 %"/>
                    </Grid>
                    <Grid MaxWidth="500" HorizontalAlignment="Left" Margin="0,4,0,0" Height="6">
                        <Border Background="#1F2640" CornerRadius="3"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="CompFillCol" Width="0*"/>
                                <ColumnDefinition x:Name="CompRestCol" Width="100*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CompFillBar" Grid.Column="0" CornerRadius="3"
                                    Background="#10B981"/>
                        </Grid>
                    </Grid>
                </StackPanel>

                <!-- Avatar -->
                <Grid Grid.Column="1" Width="76" Height="76" VerticalAlignment="Center">
                    <Border x:Name="AvatarBorder" CornerRadius="38"
                            BorderBrush="{StaticResource Primary}" BorderThickness="2"
                            Background="#1A2440" ClipToBounds="True">
                        <Grid>
                            <TextBlock x:Name="AvatarInitials" Text="?" Foreground="White"
                                       FontSize="28" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border x:Name="AvatarPhotoMask" CornerRadius="38" Visibility="Collapsed">
                                <Border.Background>
                                    <ImageBrush x:Name="AvatarPhotoBrush" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                    <Border x:Name="AvatarBadge" Width="22" Height="22" CornerRadius="11"
                            Background="{StaticResource Success}"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,-2,-2" BorderBrush="#0F1730" BorderThickness="2"
                            Visibility="Collapsed">
                        <TextBlock Text="✓" Foreground="White" FontSize="11" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Body -->
        <ScrollViewer Grid.Row="1" Padding="22,18" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Récupéré depuis Active Directory -->
                <Border Background="{StaticResource Bg1}" CornerRadius="8" Padding="16" Margin="0,0,0,18"
                        BorderBrush="{StaticResource Border}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="🔒" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock Text="Informations Active Directory (lecture seule)"
                                       Foreground="{StaticResource TextDim}" FontSize="11.5" FontWeight="SemiBold"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Prénom *" Style="{StaticResource Label}"/>
                                <TextBox x:Name="TxtFirstName" Style="{StaticResource Field}" MaxLength="80"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Nom *" Style="{StaticResource Label}"/>
                                <TextBox x:Name="TxtLastName" Style="{StaticResource Field}" MaxLength="80"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Text="Matricule (identifiant Windows)" Style="{StaticResource Label}"/>
                                <TextBox x:Name="TxtMatricule" Style="{StaticResource LockedField}"
                                         ToolTip="Identifiant Windows — non modifiable"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Text="Adresse mail *" Style="{StaticResource Label}"/>
                                <TextBox x:Name="TxtEmail" Style="{StaticResource Field}" MaxLength="150"
                                         ToolTip="Utilisée pour les notifications de tickets et habilitations"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="TxtAdStatus" Foreground="{StaticResource TextMuted}"
                                   FontSize="11" Margin="0,4,0,0"
                                   Text="Pré-rempli depuis votre compte Windows. Vous pouvez modifier prénom, nom et e-mail — l'enregistrement met à jour votre fiche annuaire."/>

                        <!-- Statut photo AD -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="📷" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="TxtPhotoStatus"
                                       Foreground="{StaticResource TextDim}" FontSize="12"
                                       VerticalAlignment="Center"
                                       Text="Aucune photo détectée dans Active Directory."/>
                            <Button Grid.Column="2" x:Name="BtnRefreshPhoto"
                                    Content="🔄 Rafraîchir depuis AD"
                                    Style="{StaticResource Btn}" Padding="10,4" FontSize="11"
                                    Click="BtnRefreshPhoto_Click"/>
                        </Grid>

                        <!-- Photo personnalisée (fichier ou webcam) -->
                        <Border Background="#0E1B33" BorderBrush="#3B82F6" BorderThickness="1"
                                CornerRadius="8" Padding="14,10" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Foreground="#A0C4FF" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8">
                                    <Run Text="📸 Mettre à jour ma photo annuaire"/>
                                </TextBlock>
                                <TextBlock Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap">
                                    Choisissez un fichier image (JPEG/PNG/WebP, max 3 Mo) ou prenez une photo avec votre webcam.
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Button x:Name="BtnUploadPhoto" Content="📁 Choisir un fichier"
                                            Style="{StaticResource Btn}" Padding="14,8" FontSize="12"
                                            Margin="0,0,8,0" Click="BtnUploadPhoto_Click"/>
                                    <Button x:Name="BtnWebcamPhoto" Content="📷 Prendre une photo (webcam)"
                                            Style="{StaticResource Btn}" Padding="14,8" FontSize="12"
                                            Click="BtnWebcamPhoto_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Saisie utilisateur -->
                <TextBlock Text="À COMPLÉTER PAR VOS SOINS" Foreground="{StaticResource TextMuted}"
                           FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <!-- Grade / Fonction -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3">
                        <TextBlock Text="Grade / Fonction *" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="CmbGrade" Style="{StaticResource Combo}"
                                  ToolTip="Sélectionnez votre grade officiel — regroupé par corps de la Police Nationale."
                                  MaxDropDownHeight="380"/>
                    </StackPanel>

                    <!-- Commissariat -->
                    <StackPanel Grid.Row="1" Grid.Column="0">
                        <TextBlock Text="Commissariat *" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="CmbCommissariat" Style="{StaticResource Combo}"/>
                    </StackPanel>

                    <!-- Service -->
                    <StackPanel Grid.Row="1" Grid.Column="2">
                        <TextBlock Text="Service / Bureau" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="CmbService" Style="{StaticResource Combo}"
                                  IsEnabled="False"
                                  ToolTip="Sélectionnez d'abord votre commissariat pour voir les services disponibles."/>
                    </StackPanel>

                    <!-- Téléphones -->
                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Text="Téléphone fixe" Style="{StaticResource Label}"/>
                        <TextBox x:Name="TxtPhoneFixed" Style="{StaticResource Field}"
                                 ToolTip="Numéro du poste fixe au commissariat (ex: 01 60 78 91 00)"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="2">
                        <TextBlock Text="Téléphone NEO (portable)" Style="{StaticResource Label}"/>
                        <TextBox x:Name="TxtPhoneNeo" Style="{StaticResource Field}"
                                 ToolTip="Numéro du téléphone NEO (mobile de service)"/>
                    </StackPanel>

                    <!-- Mobile perso (optionnel) -->
                    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3">
                        <TextBlock Text="Téléphone mobile personnel (optionnel — pour astreinte)" Style="{StaticResource Label}"/>
                        <TextBox x:Name="TxtPhoneMobile" Style="{StaticResource Field}"/>
                    </StackPanel>
                </Grid>

                <Border Background="#1A2440" CornerRadius="6" Padding="12" Margin="0,8,0,0"
                        BorderBrush="#2D3D63" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ℹ" FontSize="14" Margin="0,0,8,0" Foreground="{StaticResource Primary}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource TextDim}">
                            <Run Text="Vos coordonnées seront visibles dans l'annuaire interne consulté par les techniciens et la hiérarchie. Aucune donnée n'est transmise à l'extérieur."/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="TxtLastUpdate" Foreground="{StaticResource TextMuted}"
                           FontSize="11" Margin="0,12,0,0" />
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#0F1730" Padding="22,14"
                BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="TxtError" HorizontalAlignment="Left" VerticalAlignment="Center"
                           Foreground="#FCA5A5" FontSize="12" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnLater" Style="{StaticResource Btn}" Content="Plus tard" Margin="0,0,8,0" Click="BtnLater_Click"/>
                    <Button x:Name="BtnSave"  Style="{StaticResource PrimaryBtn}" Content="✓  Enregistrer" Click="BtnSave_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
