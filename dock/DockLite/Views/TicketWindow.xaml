<Window x:Class="DockLite.Views.TicketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DockLite.Views"
        Title="DockPolice — SAV"
        Icon="pack://application:,,,/Assets/DockPolice.ico"
        Width="1100" Height="780"
        MinWidth="900" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F19"
        Foreground="#E6EAF2"
        FontFamily="Segoe UI"
        FontSize="13"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop">

    <Window.Resources>

        <!-- ===== Value converters ===== -->
        <local:PriorityColorConverter    x:Key="PriorityColor"/>
        <local:StatusColorConverter      x:Key="StatusColor"/>
        <local:StringToVisibilityConverter x:Key="StringToVisibility"/>
        <local:AgoConverter              x:Key="Ago"/>

        <!-- ===== Colors ===== -->
        <SolidColorBrush x:Key="Bg0"       Color="#0B0F19"/>
        <SolidColorBrush x:Key="Bg1"       Color="#121829"/>
        <SolidColorBrush x:Key="Bg2"       Color="#1A2137"/>
        <SolidColorBrush x:Key="Bg3"       Color="#232B44"/>
        <SolidColorBrush x:Key="Border"    Color="#2A3350"/>
        <SolidColorBrush x:Key="BorderDim" Color="#1F2640"/>
        <SolidColorBrush x:Key="Text"      Color="#E6EAF2"/>
        <SolidColorBrush x:Key="TextDim"   Color="#96A1C0"/>
        <SolidColorBrush x:Key="TextMuted" Color="#6C7690"/>
        <SolidColorBrush x:Key="Primary"   Color="#4E8BFF"/>
        <SolidColorBrush x:Key="PrimaryHover" Color="#6FA2FF"/>
        <SolidColorBrush x:Key="Danger"    Color="#EF4444"/>
        <SolidColorBrush x:Key="Warning"   Color="#F59E0B"/>
        <SolidColorBrush x:Key="Success"   Color="#10B981"/>
        <SolidColorBrush x:Key="Info"      Color="#06B6D4"/>

        <!-- ===== Typography helpers ===== -->
        <Style TargetType="TextBlock" x:Key="SectionTitle">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="ChipLabel">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="ChipValue">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- ===== TextBox (modern) ===== -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Bg2}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Primary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Padding="{TemplateBinding Padding}"
                                          VerticalContentAlignment="Center"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Auto"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3A4670"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== ComboBox (modern dark) ===== -->
        <Style x:Key="ComboToggleStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ClickMode" Value="Press"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{StaticResource Bg2}"
                                BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource Bg2}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Grid.Column="2"
                                          Style="{StaticResource ComboToggleStyle}"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                            <Path x:Name="Arrow"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0,0,14,0"
                                  Fill="{StaticResource TextDim}"
                                  Data="M 0 0 L 4 5 L 8 0 Z"
                                  Width="8" Height="5"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                      MinWidth="{TemplateBinding ActualWidth}">
                                    <Border x:Name="DropDownBorder"
                                            Background="{StaticResource Bg2}"
                                            BorderBrush="{StaticResource Border}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Margin="0,4,0,0">
                                        <ScrollViewer Margin="4" VerticalScrollBarVisibility="Auto">
                                            <StackPanel IsItemsHost="True"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleButton" Property="BorderBrush" Value="#3A4670"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="ToggleButton" Property="BorderBrush" Value="{StaticResource Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd"
                                            Background="Transparent"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg3}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#2D5DB8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Buttons ===== -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Primary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D5DB8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg3}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnGhost" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg3}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3A4670"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{StaticResource Bg2}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg3}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Icon button (composer toolbar) ===== -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg3}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D5DB8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Search box ===== -->
        <Style x:Key="SearchBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="32,8,10,8"/>
            <Setter Property="Height" Value="36"/>
        </Style>

        <!-- ===== Tabs ===== -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="22,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border x:Name="Bd" BorderThickness="0,0,0,2" BorderBrush="Transparent"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Primary}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
    <DockPanel>

        <!-- ======================= HEADER ======================= -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Bg1}"
                BorderBrush="{StaticResource BorderDim}" BorderThickness="0,0,0,1"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="11" Margin="0,0,14,0"
                        VerticalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#4E8BFF" Offset="0"/>
                            <GradientStop Color="#1E3A8A" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Image Source="pack://application:,,,/Assets/logo.png" Width="30" Height="30"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Service Après-Vente" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource Text}"/>
                    <TextBlock x:Name="HeaderSub" Text="Créer un ticket ou suivre vos demandes"
                               FontSize="12" Foreground="{StaticResource TextDim}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" x:Name="RemoteAssistBtn"
                        Click="RemoteAssistBtn_Click"
                        Background="#1A2440" BorderBrush="#4E8BFF" BorderThickness="1"
                        Foreground="#A0C4FF" Padding="12,8" Cursor="Hand"
                        VerticalAlignment="Center"
                        ToolTip="Générer un code à 6 chiffres pour autoriser le technicien à prendre la main sur votre poste">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🖥️" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="Permettre prise en main" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Bandeau "Mise à jour disponible" si pending -->
        <Border DockPanel.Dock="Top" x:Name="UpdatePendingBanner" Visibility="Collapsed"
                Background="#0E2A1F" BorderBrush="#10B981" BorderThickness="0,0,0,1"
                Padding="20,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="✓" FontSize="14" Foreground="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="UpdatePendingText" Foreground="#6EE7B7" FontSize="12" VerticalAlignment="Center"
                           Text="Une nouvelle version est prête. Elle s'installera au prochain démarrage de DockPolice."/>
            </StackPanel>
        </Border>

        <TabControl Background="{StaticResource Bg0}" BorderThickness="0" Padding="0">

            <!-- ================================================================= -->
            <!-- Onglet 1 : Nouvelle demande                                        -->
            <!-- ================================================================= -->
            <TabItem Header="Nouvelle demande">
                <DockPanel>

                    <!-- ======== Bottom actions bar ======== -->
                    <Border DockPanel.Dock="Bottom"
                            Background="{StaticResource Bg1}"
                            BorderBrush="{StaticResource BorderDim}"
                            BorderThickness="0,1,0,0" Padding="24,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" x:Name="StatusPill"
                                    CornerRadius="6" Padding="10,6"
                                    HorizontalAlignment="Left"
                                    Background="#00000000" BorderThickness="1" BorderBrush="#00000000"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="StatusLabel" Foreground="{StaticResource Text}" FontSize="12"/>
                            </Border>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="CancelButton" Content="Annuler" IsCancel="True"
                                        Style="{StaticResource BtnGhost}" Click="Cancel_Click" Margin="0,0,8,0"/>
                                <Button x:Name="SubmitButton" Content="Envoyer la demande"
                                        Style="{StaticResource BtnPrimary}"
                                        IsDefault="True" Click="Submit_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
                        <StackPanel>

                            <!-- ===== Détails de la demande ===== -->
                            <TextBlock Text="VOTRE DEMANDE" Style="{StaticResource SectionTitle}"/>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Catégorie" Style="{StaticResource Label}"/>
                                    <ComboBox x:Name="CategoryBox"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Priorité" Style="{StaticResource Label}"/>
                                    <ComboBox x:Name="PriorityBox"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="E-mail" Style="{StaticResource Label}"/>
                            <TextBlock Text="Pour être notifié des réponses (optionnel)"
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       Margin="0,-4,0,6"/>
                            <TextBox x:Name="EmailBox" MaxLength="150" Margin="0,0,0,14"/>

                            <TextBlock Text="Sujet" Style="{StaticResource Label}"/>
                            <TextBox x:Name="SubjectBox" MaxLength="200" Margin="0,0,0,14"/>

                            <TextBlock Text="Description du problème" Style="{StaticResource Label}"/>
                            <TextBox x:Name="DescriptionBox" Height="170" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"/>
                            <TextBlock Foreground="{StaticResource TextMuted}" FontSize="11"
                                       Margin="2,4,0,18">
                                <Run Text="Plus la description est précise (étapes pour reproduire, messages d'erreur), plus vite la demande pourra être traitée."/>
                            </TextBlock>

                            <!-- ===== Contexte du poste (déplacé sous la demande) ===== -->
                            <TextBlock Text="CONTEXTE DU POSTE" Style="{StaticResource SectionTitle}"/>
                            <Border Background="{StaticResource Bg1}"
                                    BorderBrush="{StaticResource BorderDim}" BorderThickness="1"
                                    CornerRadius="10" Padding="18" Margin="0,0,0,22">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,16,12">
                                        <TextBlock Text="MACHINE" Style="{StaticResource ChipLabel}"/>
                                        <TextBlock x:Name="MachineText" Style="{StaticResource ChipValue}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,0,12">
                                        <TextBlock Text="UTILISATEUR" Style="{StaticResource ChipLabel}"/>
                                        <TextBlock x:Name="UserText" Style="{StaticResource ChipValue}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,16,12">
                                        <TextBlock Text="SYSTÈME" Style="{StaticResource ChipLabel}"/>
                                        <TextBlock x:Name="OsText" Style="{StaticResource ChipValue}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Grid.Row="1" Margin="0,0,0,12">
                                        <TextBlock Text="ADRESSE IP" Style="{StaticResource ChipLabel}"/>
                                        <TextBlock x:Name="IpText" Style="{StaticResource ChipValue}"/>
                                    </StackPanel>

                                    <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2"
                                            Background="{StaticResource Bg2}" CornerRadius="7" Padding="12,10">
                                        <StackPanel>
                                            <TextBlock Text="COMMISSARIAT DE RATTACHEMENT" Style="{StaticResource ChipLabel}"/>
                                            <TextBlock x:Name="CommissariatText" Style="{StaticResource ChipValue}"
                                                       Foreground="{StaticResource Text}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Toggle « Détails techniques complets » -->
                            <Grid Margin="0,-14,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnToggleSysInfo" Grid.Column="0"
                                        Content="▼ Afficher les détails techniques complets (CPU, RAM, BIOS, disques…)"
                                        HorizontalAlignment="Left" Background="Transparent"
                                        BorderThickness="0" Foreground="#A0C4FF"
                                        Padding="0,6" Cursor="Hand"
                                        Click="BtnToggleSysInfo_Click"/>
                                <Button x:Name="BtnAttachSysInfo" Grid.Column="1"
                                        Content="📋 Joindre dans la description"
                                        Background="#1A2440" BorderBrush="#3B82F6" Foreground="#A0C4FF"
                                        Padding="10,6" FontSize="11.5"
                                        Click="BtnAttachSysInfo_Click"
                                        ToolTip="Insère le rapport technique complet dans la description du ticket"/>
                            </Grid>

                            <!-- Panel détails (caché par défaut) -->
                            <Border x:Name="SysInfoPanel" Visibility="Collapsed"
                                    Background="{StaticResource Bg1}" BorderBrush="#3B82F6" BorderThickness="1"
                                    CornerRadius="10" Padding="14" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Foreground="#A0C4FF" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,8">
                                        <Run Text="🖥 RAPPORT TECHNIQUE COMPLET"/>
                                    </TextBlock>
                                    <Grid x:Name="SysInfoGrid">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Lignes injectées en code-behind -->
                                    </Grid>
                                    <TextBlock x:Name="SysInfoStatus" Foreground="{StaticResource TextMuted}"
                                               FontSize="11" Margin="0,8,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>

                            <!-- (Bandeau Firefox déplacé vers l'onglet Market) -->

                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- ================================================================= -->
            <!-- Onglet 2 : Mes tickets                                             -->
            <!-- ================================================================= -->
            <TabItem x:Name="MyTicketsTab" Header="Mes tickets" GotFocus="MyTicketsTab_GotFocus">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" MinWidth="320"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*" MinWidth="380"/>
                    </Grid.ColumnDefinitions>

                    <!-- ============== LEFT PANE : ticket list ============== -->
                    <DockPanel Grid.Column="0" Margin="20,18,16,16">
                        <!-- Header (count + refresh) -->
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="MES DEMANDES" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/>
                                <TextBlock x:Name="MyTicketsCount"
                                           Foreground="{StaticResource TextDim}" FontSize="12"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource IconButton}"
                                    Click="RefreshMyTickets_Click"
                                    ToolTip="Rafraîchir la liste"
                                    Content="↻"/>
                        </Grid>

                        <!-- Search box -->
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBox x:Name="SearchBox" Style="{StaticResource SearchBoxStyle}"
                                     TextChanged="SearchBox_TextChanged"/>
                            <TextBlock IsHitTestVisible="False"
                                       Text="🔍" FontSize="13" Foreground="{StaticResource TextMuted}"
                                       VerticalAlignment="Center" Margin="11,0,0,0"/>
                            <TextBlock x:Name="SearchPlaceholder" IsHitTestVisible="False"
                                       Text="Rechercher un ticket…"
                                       FontSize="12.5" Foreground="{StaticResource TextMuted}"
                                       VerticalAlignment="Center" Margin="32,0,0,0"/>
                        </Grid>

                        <!-- Status filter pills -->
                        <ItemsControl DockPanel.Dock="Top" Margin="0,0,0,10">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <RadioButton x:Name="FilterActive" GroupName="StatusFilter" IsChecked="True"
                                         Content="Actifs" Tag="active"
                                         Checked="FilterPill_Checked"
                                         Style="{DynamicResource FilterPillStyle}"
                                         ToolTip="Tickets ouverts + en cours (sélection par défaut)"/>
                            <RadioButton x:Name="FilterAll" GroupName="StatusFilter"
                                         Content="Tous" Tag="all"
                                         Checked="FilterPill_Checked"
                                         Style="{DynamicResource FilterPillStyle}"/>
                            <RadioButton GroupName="StatusFilter" Content="Ouverts" Tag="Ouvert"
                                         Checked="FilterPill_Checked"
                                         Style="{DynamicResource FilterPillStyle}"/>
                            <RadioButton GroupName="StatusFilter" Content="En cours" Tag="En cours"
                                         Checked="FilterPill_Checked"
                                         Style="{DynamicResource FilterPillStyle}"/>
                            <RadioButton GroupName="StatusFilter" Content="Résolus" Tag="Résolu"
                                         Checked="FilterPill_Checked"
                                         Style="{DynamicResource FilterPillStyle}"/>
                            <ItemsControl.Resources>
                                <Style x:Key="FilterPillStyle" TargetType="RadioButton">
                                    <Setter Property="Margin" Value="0,0,6,6"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="FontSize" Value="11.5"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
                                    <Setter Property="Padding" Value="11,5"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="RadioButton">
                                                <Border x:Name="Bd"
                                                        Background="{StaticResource Bg2}"
                                                        BorderBrush="{StaticResource BorderDim}"
                                                        BorderThickness="1"
                                                        CornerRadius="14"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#3A4670"/>
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#1C2A52"/>
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Primary}"/>
                                                        <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ItemsControl.Resources>
                        </ItemsControl>

                        <ListView x:Name="MyTicketsList"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="{StaticResource Text}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch"
                              SelectionChanged="MyTicketsList_SelectionChanged">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="Bd"
                                                    Background="{StaticResource Bg1}"
                                                    BorderBrush="{StaticResource BorderDim}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="14,12">
                                                <ContentPresenter HorizontalAlignment="Stretch"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#3A4670"/>
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg2}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Primary}"/>
                                                    <Setter TargetName="Bd" Property="Background" Value="#1C2A52"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Pastille priorité -->
                                    <Ellipse Grid.Column="0" Width="10" Height="10"
                                             VerticalAlignment="Center" Margin="0,0,14,0"
                                             Fill="{Binding Priority, Converter={StaticResource PriorityColor}, ConverterParameter=fg}"/>

                                    <!-- Corps -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Id, StringFormat='#{0}'}"
                                                       Foreground="{StaticResource TextMuted}"
                                                       FontSize="12" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding Subject}"
                                                       Foreground="{StaticResource Text}"
                                                       FontSize="13.5" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding Category}"
                                                       Foreground="{StaticResource TextDim}" FontSize="11.5"/>
                                            <TextBlock Text=" · "
                                                       Foreground="{StaticResource TextMuted}" FontSize="11.5"/>
                                            <TextBlock Text="{Binding CreatedAt, Converter={StaticResource Ago}}"
                                                       Foreground="{StaticResource TextMuted}" FontSize="11.5"/>
                                            <TextBlock Text="  ·  assigné à "
                                                       Foreground="{StaticResource TextMuted}" FontSize="11.5"
                                                       Visibility="{Binding AssignedTo, Converter={StaticResource StringToVisibility}}"/>
                                            <TextBlock Text="{Binding AssignedTo}"
                                                       Foreground="{StaticResource TextDim}" FontSize="11.5"
                                                       FontWeight="Medium"
                                                       Visibility="{Binding AssignedTo, Converter={StaticResource StringToVisibility}}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Badges droite -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border CornerRadius="10" Padding="10,4" Margin="0,0,8,0"
                                                Background="{Binding Priority, Converter={StaticResource PriorityColor}, ConverterParameter=bg}"
                                                BorderThickness="1"
                                                BorderBrush="{Binding Priority, Converter={StaticResource PriorityColor}, ConverterParameter=fg}">
                                            <TextBlock Text="{Binding Priority}" FontSize="10.5" FontWeight="SemiBold"
                                                       Foreground="{Binding Priority, Converter={StaticResource PriorityColor}, ConverterParameter=fg}"/>
                                        </Border>
                                        <Border CornerRadius="10" Padding="10,4"
                                                Background="{Binding Status, Converter={StaticResource StatusColor}, ConverterParameter=bg}"
                                                BorderThickness="1"
                                                BorderBrush="{Binding Status, Converter={StaticResource StatusColor}, ConverterParameter=fg}">
                                            <TextBlock Text="{Binding Status}" FontSize="10.5" FontWeight="SemiBold"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusColor}, ConverterParameter=fg}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    </DockPanel>

                    <!-- ===== Vertical separator ===== -->
                    <Border Grid.Column="1" Background="{StaticResource BorderDim}"/>

                    <!-- ============== RIGHT PANE : conversation ============== -->
                    <Grid Grid.Column="2" Background="{StaticResource Bg0}">

                        <!-- Empty state (no ticket selected) -->
                        <StackPanel x:Name="EmptyDetail"
                                    VerticalAlignment="Center" HorizontalAlignment="Center"
                                    MaxWidth="320">
                            <Border Width="64" Height="64" CornerRadius="16"
                                    HorizontalAlignment="Center" Margin="0,0,0,16">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#4E8BFF" Offset="0"/>
                                        <GradientStop Color="#1E3A8A" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="💬" FontSize="30"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Sélectionnez une demande"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource Text}"
                                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="Choisissez un ticket à gauche pour consulter la conversation et répondre au support."
                                       FontSize="12" Foreground="{StaticResource TextDim}"
                                       TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>

                        <!-- Detail (visible when a ticket is selected) -->
                        <DockPanel x:Name="DetailBox" Visibility="Collapsed" LastChildFill="True">

                            <!-- Header bar -->
                            <Border DockPanel.Dock="Top"
                                    Background="{StaticResource Bg1}"
                                    BorderBrush="{StaticResource BorderDim}" BorderThickness="0,0,0,1"
                                    Padding="22,16">
                                <StackPanel>
                                    <TextBlock x:Name="DetailHeader"
                                               FontWeight="SemiBold" FontSize="15"
                                               Foreground="{StaticResource Text}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="DetailMeta"
                                               Foreground="{StaticResource TextDim}" FontSize="11.5"
                                               Margin="0,4,0,0"/>
                                    <TextBlock x:Name="DetailBody"
                                               Foreground="{StaticResource TextDim}" FontSize="12"
                                               TextWrapping="Wrap" MaxHeight="60"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Carte Technicien assigné (photo + nom + téléphone) -->
                            <Border x:Name="TechCard" DockPanel.Dock="Top" Visibility="Collapsed"
                                    Margin="22,14,22,0" Padding="14"
                                    Background="{StaticResource Bg2}"
                                    BorderBrush="{StaticResource BorderDim}" BorderThickness="1"
                                    CornerRadius="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Avatar -->
                                    <Grid Grid.Column="0" Width="56" Height="56" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <!-- Initiale (fallback, toujours présent en arrière-plan) -->
                                        <Border CornerRadius="28">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#4E8BFF" Offset="0"/>
                                                    <GradientStop Color="#7B3FE4" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock x:Name="TechInitial"
                                                       Text="?" FontSize="24" FontWeight="Bold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <!-- Photo (par-dessus si dispo) -->
                                        <Ellipse x:Name="TechAvatarImg" Width="56" Height="56" Visibility="Collapsed">
                                            <Ellipse.Fill>
                                                <ImageBrush x:Name="TechAvatarBrush" Stretch="UniformToFill"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </Grid>

                                    <!-- Nom + rôle + matricule -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🪪 TECHNICIEN ASSIGNÉ"
                                                       Foreground="{StaticResource TextMuted}"
                                                       FontSize="10.5" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TechNameText"
                                                   FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Text}"
                                                   Margin="0,2,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock x:Name="TechRoleBadge"
                                                       FontSize="10" FontWeight="SemiBold"
                                                       Foreground="#A0C4FF"
                                                       Background="#1F2C4D"
                                                       Padding="6,2"
                                                       Visibility="Collapsed"/>
                                            <TextBlock x:Name="TechUsernameText"
                                                       Foreground="{StaticResource TextMuted}"
                                                       FontSize="11.5" FontFamily="Consolas"
                                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Bouton téléphone (avec icône) -->
                                    <Button x:Name="TechPhoneBtn" Grid.Column="2"
                                            Visibility="Collapsed"
                                            Padding="14,8"
                                            Background="#10B981" Foreground="White"
                                            BorderThickness="0" Cursor="Hand"
                                            FontWeight="SemiBold" FontSize="13"
                                            VerticalAlignment="Center"
                                            Click="TechPhone_Click"
                                            ToolTip="Cliquer pour copier le numéro">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📞" FontSize="14" Margin="0,0,8,0"/>
                                            <TextBlock x:Name="TechPhoneText"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- CSAT panel (visible when ticket résolu) -->
                            <Border x:Name="CsatPanel" DockPanel.Dock="Top" Visibility="Collapsed"
                                    Margin="22,14,22,0" Padding="18,14"
                                    CornerRadius="12">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#1C2A52" Offset="0"/>
                                        <GradientStop Color="#1A2137" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel>
                                    <TextBlock Text="✓ Comment évaluez-vous la résolution de votre demande ?"
                                               FontWeight="SemiBold" FontSize="13"
                                               Foreground="{StaticResource Text}" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock x:Name="Star1" Text="☆" Tag="1" FontSize="26"
                                                   Foreground="#FBBF24" Cursor="Hand" Margin="0,0,4,0"
                                                   MouseLeftButtonUp="Star_Click"/>
                                        <TextBlock x:Name="Star2" Text="☆" Tag="2" FontSize="26"
                                                   Foreground="#FBBF24" Cursor="Hand" Margin="0,0,4,0"
                                                   MouseLeftButtonUp="Star_Click"/>
                                        <TextBlock x:Name="Star3" Text="☆" Tag="3" FontSize="26"
                                                   Foreground="#FBBF24" Cursor="Hand" Margin="0,0,4,0"
                                                   MouseLeftButtonUp="Star_Click"/>
                                        <TextBlock x:Name="Star4" Text="☆" Tag="4" FontSize="26"
                                                   Foreground="#FBBF24" Cursor="Hand" Margin="0,0,4,0"
                                                   MouseLeftButtonUp="Star_Click"/>
                                        <TextBlock x:Name="Star5" Text="☆" Tag="5" FontSize="26"
                                                   Foreground="#FBBF24" Cursor="Hand" Margin="0,0,12,0"
                                                   MouseLeftButtonUp="Star_Click"/>
                                        <TextBlock Text="(1 = très insatisfait, 5 = excellent)"
                                                   Foreground="{StaticResource TextDim}" FontSize="11"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBox x:Name="CsatComment" MinHeight="32" MaxHeight="60"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="CsatSubmitButton" Content="Envoyer ma note"
                                                Style="{StaticResource BtnPrimary}"
                                                Padding="16,7" Click="CsatSubmit_Click"/>
                                        <TextBlock x:Name="CsatThanks" Visibility="Collapsed"
                                                   Foreground="#10B981" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Margin="14,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Composer (sticky bottom) -->
                            <Border DockPanel.Dock="Bottom"
                                    Background="{StaticResource Bg1}"
                                    BorderBrush="{StaticResource BorderDim}" BorderThickness="0,1,0,0"
                                    Padding="18,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Reply input -->
                                    <Border Grid.Column="0"
                                            Background="{StaticResource Bg2}"
                                            BorderBrush="{StaticResource Border}" BorderThickness="1"
                                            CornerRadius="10" Padding="4,2,4,2"
                                            VerticalAlignment="Stretch">
                                        <DockPanel LastChildFill="True">
                                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                                        HorizontalAlignment="Left" Margin="6,0,0,4">
                                                <Button x:Name="AttachButton" Style="{StaticResource IconButton}"
                                                        ToolTip="Joindre un fichier" Click="Attach_Click"
                                                        Content="📎"/>
                                                <Button x:Name="ScreenshotButton" Style="{StaticResource IconButton}"
                                                        ToolTip="Capturer l'écran et l'envoyer" Click="Screenshot_Click"
                                                        Content="🖼"/>
                                            </StackPanel>
                                            <TextBox x:Name="ReplyBox"
                                                     MinHeight="44" MaxHeight="140"
                                                     AcceptsReturn="True" TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto"
                                                     BorderThickness="0" Background="Transparent"
                                                     Padding="8,9,8,4"
                                                     KeyDown="ReplyBox_KeyDown"/>
                                        </DockPanel>
                                    </Border>

                                    <Button Grid.Column="1" x:Name="SendReplyButton"
                                            Content="Envoyer  ▸"
                                            Style="{StaticResource BtnPrimary}"
                                            Margin="10,0,0,0" Padding="22,12"
                                            VerticalAlignment="Bottom"
                                            Click="SendReply_Click" IsDefault="False"/>
                                </Grid>
                            </Border>

                            <!-- Thread -->
                            <ScrollViewer x:Name="CommentsScroll"
                                          VerticalScrollBarVisibility="Auto"
                                          Padding="22,16">
                                <StackPanel x:Name="CommentsPanel"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ================================================================= -->
            <!-- Onglet 3 : Demande d'habilitation                                  -->
            <!-- ================================================================= -->
            <TabItem x:Name="HabilTab" Header="Habilitations" GotFocus="HabilTab_GotFocus">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
                    <StackPanel MaxWidth="700" HorizontalAlignment="Stretch">

                        <!-- Bandeau info -->
                        <Border Background="#0E1B33" BorderBrush="#3B82F6" BorderThickness="1"
                                CornerRadius="10" Padding="16,12" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="🪪 Demande d'habilitation logiciel"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource Text}" Margin="0,0,0,4"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDim}" FontSize="12">
                                    <Run Text="Demandez l'accès à un logiciel métier (Mercure, Cheops, LRPPN…). "/>
                                    <Run Text="Joignez le PDF Dialogue signé par votre hiérarchie pour accélérer le traitement."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- ============= Mes habilitations existantes ============= -->
                        <TextBlock Text="MES HABILITATIONS" Style="{StaticResource SectionTitle}"/>
                        <Border x:Name="HabilListWrap"
                                Background="{StaticResource Bg1}" BorderBrush="{StaticResource BorderDim}"
                                BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,22">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Foreground="{StaticResource TextDim}" FontSize="11.5"
                                               x:Name="HabilListSubtitle"
                                               Text="Suivi de vos demandes — état, dates et progression."/>
                                    <Button Grid.Column="1" x:Name="HabilListRefreshBtn"
                                            Content="🔄"
                                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextDim}"
                                            Padding="6,2" Cursor="Hand"
                                            Click="HabilListRefresh_Click"
                                            ToolTip="Actualiser la liste"/>
                                </Grid>
                                <ItemsControl x:Name="HabilList" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource Bg2}"
                                                    BorderBrush="{Binding StatusBrush}" BorderThickness="0,0,0,0"
                                                    CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderThickness" Value="0,0,0,0"/>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Software}" FontWeight="SemiBold" FontSize="13"
                                                                           Foreground="{StaticResource Text}"/>
                                                                <TextBlock Text="{Binding ProfileSuffix}" FontSize="12"
                                                                           Foreground="{StaticResource TextDim}" Margin="6,0,0,0"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Ref}" FontFamily="Consolas" FontSize="10.5"
                                                                       Foreground="#4DABF7" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="1" CornerRadius="999" Padding="8,3"
                                                                Background="{Binding StatusBg}">
                                                            <TextBlock Text="{Binding StatusLabel}" FontSize="10.5" FontWeight="SemiBold"
                                                                       Foreground="{Binding StatusFg}"/>
                                                        </Border>
                                                    </Grid>

                                                    <!-- Barre de progression (proportionnelle, prend toute la largeur) -->
                                                    <Grid Margin="0,8,0,4" Height="6">
                                                        <Border Background="#1F2640" CornerRadius="3"/>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="{Binding ProgressColumnWidth}"/>
                                                                <ColumnDefinition Width="{Binding RestColumnWidth}"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Background="{Binding StatusBg}" CornerRadius="3"/>
                                                        </Grid>
                                                    </Grid>

                                                    <Grid Margin="0,4,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding DateInfo}"
                                                                   FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding ProgressPctText}"
                                                                   FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{Binding StatusFg}"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="HabilListEmpty"
                                           Visibility="Visible"
                                           Foreground="{StaticResource TextMuted}" FontSize="12" FontStyle="Italic"
                                           HorizontalAlignment="Center" Margin="0,12,0,12"
                                           Text="Aucune demande enregistrée. Utilisez le formulaire ci-dessous pour en créer une."/>
                            </StackPanel>
                        </Border>

                        <!-- Logiciel -->
                        <TextBlock Text="LOGICIEL CONCERNÉ" Style="{StaticResource SectionTitle}"/>
                        <ComboBox x:Name="HabilSoftwareBox"
                                  DisplayMemberPath="Label" SelectedValuePath="Key"
                                  Margin="0,0,0,14"
                                  SelectionChanged="HabilSoftware_SelectionChanged"/>

                        <!-- Profil (filtré par logiciel) -->
                        <TextBlock Text="PROFIL DEMANDÉ" Style="{StaticResource SectionTitle}"/>
                        <ComboBox x:Name="HabilProfileBox" Margin="0,0,0,14" IsEnabled="False"/>

                        <!-- Périmètre -->
                        <TextBlock Text="Périmètre / précision (optionnel)" Style="{StaticResource Label}"/>
                        <TextBlock Text="Ex: Limité à mon CPN, Région Île-de-France, etc."
                                   Foreground="{StaticResource TextMuted}" FontSize="11"
                                   Margin="0,-4,0,6"/>
                        <TextBox x:Name="HabilScopeBox" MaxLength="200" Margin="0,0,0,14"/>

                        <!-- Notes -->
                        <TextBlock Text="Justification / commentaire" Style="{StaticResource Label}"/>
                        <TextBox x:Name="HabilNotesBox" Height="100" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top" Margin="0,0,0,14"/>

                        <!-- PDF Dialogue (OBLIGATOIRE) -->
                        <TextBlock Style="{StaticResource Label}">
                            <Run Text="PDF Dialogue avec avis chef de service "/>
                            <Run Text="*" Foreground="#EF4444" FontWeight="Bold"/>
                        </TextBlock>
                        <TextBlock Foreground="{StaticResource TextMuted}" FontSize="11"
                                   Margin="0,-4,0,6" TextWrapping="Wrap">
                            <Run Text="⚠ Document obligatoire : généré par le logiciel "/>
                            <Run Text="Dialogue" FontWeight="SemiBold" Foreground="#A0C4FF"/>
                            <Run Text=" et portant impérativement l'"/>
                            <Run Text="avis signé du chef de service" FontWeight="SemiBold" Foreground="#A0C4FF"/>
                            <Run Text=". Sans ce document, la demande ne peut être traitée."/>
                        </TextBlock>
                        <Border x:Name="HabilPdfWrap"
                                Background="#1F0F0F" BorderBrush="#7F1D1D" BorderThickness="1"
                                CornerRadius="8" Padding="2" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="HabilPdfPathBox" Grid.Column="0" IsReadOnly="True"
                                         Background="Transparent" BorderThickness="0"
                                         Padding="10,8"
                                         Foreground="#FCA5A5"
                                         Text="Aucun PDF sélectionné — fichier requis"/>
                                <Button Grid.Column="1" x:Name="HabilPdfPickBtn" Content="📎 Choisir le PDF…"
                                        Margin="4" Padding="14,8"
                                        Click="HabilPdfPick_Click"/>
                            </Grid>
                        </Border>

                        <!-- Statut + bouton submit -->
                        <Border x:Name="HabilStatusBox" Visibility="Collapsed"
                                Padding="14,10" CornerRadius="8" Margin="0,0,0,12"
                                Background="#0E2A1F" BorderBrush="#10B981" BorderThickness="1">
                            <TextBlock x:Name="HabilStatusText" Foreground="#6EE7B7" FontWeight="SemiBold"/>
                        </Border>

                        <Button x:Name="HabilSubmitBtn" Content="🪪 Envoyer la demande"
                                Style="{StaticResource BtnPrimary}"
                                Padding="22,12" HorizontalAlignment="Left"
                                Click="HabilSubmit_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================================================================= -->
            <!-- Onglet 4 : Market — bibliothèque XPI Firefox (dynamique)           -->
            <!-- ================================================================= -->
            <TabItem x:Name="MarketTab" Header="Market" GotFocus="MarketTab_GotFocus">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Stretch">

                        <!-- Bandeau d'introduction -->
                        <Border Background="#0E1B33" BorderBrush="#3B82F6" BorderThickness="1"
                                CornerRadius="10" Padding="16,12" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="🛒 Market — Extensions Firefox"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource Text}" Margin="0,0,0,4"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDim}" FontSize="12">
                                    <Run Text="Catalogue interne d'extensions Firefox validées par la DSI. "/>
                                    <Run Text="Téléchargez le .xpi ou cliquez sur Installer pour un déploiement automatique avec configuration."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="EXTENSIONS DISPONIBLES" Style="{StaticResource SectionTitle}"/>

                        <!-- Liste dynamique des extensions (peuplée en code-behind via API) -->
                        <StackPanel x:Name="MarketCards"/>

                        <!-- État de chargement / erreur -->
                        <Border x:Name="MarketLoading" Background="{StaticResource Bg2}"
                                BorderBrush="{StaticResource Border}" BorderThickness="1"
                                CornerRadius="10" Padding="16,14" Margin="0,8,0,0" HorizontalAlignment="Stretch">
                            <TextBlock x:Name="MarketLoadingText"
                                       Text="⏳ Chargement du catalogue…"
                                       Foreground="{StaticResource TextDim}" FontSize="12"
                                       HorizontalAlignment="Center"/>
                        </Border>

                        <Border x:Name="MarketEmpty" Visibility="Collapsed"
                                Background="#3D2912" BorderBrush="#F97316" BorderThickness="1"
                                CornerRadius="10" Padding="14,12" Margin="0,8,0,0">
                            <TextBlock Foreground="#FBA571" FontSize="12" TextWrapping="Wrap">
                                <Run Text="ℹ️ Le catalogue est vide. "/>
                                <Run Text="Demandez à un administrateur d'ajouter des extensions depuis le backoffice (Market &gt; Nouvelle extension)."/>
                            </TextBlock>
                        </Border>


                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>

    <!-- Overlay Drag & Drop : visible quand un fichier est traîné sur la fenêtre -->
    <Border x:Name="DropOverlay" Visibility="Collapsed"
            Background="#CC0B0F19" IsHitTestVisible="False">
        <Border CornerRadius="20" BorderBrush="#4E8BFF" BorderThickness="3"
                Background="#1A2440" HorizontalAlignment="Center" VerticalAlignment="Center"
                Padding="40,30">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="📎" FontSize="64" HorizontalAlignment="Center" Foreground="#4E8BFF"/>
                <TextBlock Text="Lâchez le fichier pour le joindre à une nouvelle demande"
                           FontSize="16" FontWeight="SemiBold" Foreground="White"
                           HorizontalAlignment="Center" Margin="0,12,0,4"/>
                <TextBlock Text="Le formulaire SAV sera pré-rempli avec ce fichier en pièce jointe."
                           FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Border>
    </Grid>
</Window>
