<Window x:Class="DockLite.Views.SystemInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Informations machine"
        Icon="pack://application:,,,/Assets/DockPolice.ico"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Foreground="White"
        FontFamily="Segoe UI"
        ResizeMode="CanMinimize">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Foreground" Value="#9BB6D9"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Value">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Border Padding="20">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Image Source="pack://application:,,,/Assets/logo.png"
                       Width="56" Height="56"
                       Margin="0,0,14,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="DockPolice"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="White"/>
                    <TextBlock Text="Informations machine"
                               FontSize="12"
                               Foreground="#9BB6D9"/>
                </StackPanel>
            </StackPanel>

            <Grid x:Name="InfoGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
            </Grid>

            <!-- Le bandeau « Extension Firefox · Coffre-fort + 2FA » a été retiré avec
                 le code qui l'animait : son bouton appelait « vault-extension-deploy.php »
                 sur le backoffice d'origine. Laisser le bandeau sans son appel aurait
                 donné un bouton qui ne fait rien — pire qu'une fonction absente, parce
                 qu'on le presse plusieurs fois avant de conclure à une panne. -->

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <Button x:Name="CopyButton"
                        Content="Copier"
                        Padding="14,6"
                        Margin="0,0,8,0"
                        Click="Copy_Click"/>
                <Button x:Name="CloseButton"
                        Content="Fermer"
                        Padding="14,6"
                        IsCancel="True"
                        Click="Close_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
