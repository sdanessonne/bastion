<?xml version="1.0" encoding="utf-8"?>
<!--
  Bastion — paquet MSI de la station blanche.

  Construction :
      cd station-blanche
      dotnet publish -c Release -o publish
      wix build msi\BastionStationBlanche.wxs -o publish\BastionStationBlanche.msi

  DEUX CHOIX QUI NE SONT PAS ANODINS

  1. Installation sous ProgramData, pas Program Files.
     Le logiciel enregistre sa configuration — adresse de la passerelle et jeton
     de station — dans un « station.json » placé À CÔTÉ de l'exécutable. Dans
     Program Files, ce dossier n'est pas accessible en écriture à un compte
     ordinaire : l'écran de configuration refuserait d'enregistrer, avec un
     message que personne ne rattacherait aux droits du dossier.

  2. UpgradeCode FIXE, Version variable.
     C'est ce couple qui permet à une nouvelle version de REMPLACER l'ancienne
     au lieu de s'installer à côté. Changer l'UpgradeCode par mégarde ferait
     cohabiter deux stations blanches sur le même poste, chacune avec sa
     configuration — et l'agent ne saurait pas laquelle il utilise.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="Bastion — Station blanche"
           Manufacturer="Mickaël MONESTIER"
           Version="1.0.0"
           UpgradeCode="7F3A9C21-4E86-4B57-9D2C-8A1E5B4F0C63"
           Scope="perMachine"
           Compressed="yes"
           Language="1036">

    <SummaryInformation Description="Analyse des supports amovibles — poste de station blanche" />

    <!-- Refuse une installation par-dessus une version plus récente, et le DIT :
         sans ce message, l'installeur échouerait sur un code d'erreur nu. -->
    <MajorUpgrade DowngradeErrorMessage="Une version plus récente de la station blanche est déjà installée sur ce poste." />

    <MediaTemplate EmbedCab="yes" />

    <!-- Écran de licence puis dossier : l'exploitant doit pouvoir déplacer
         l'installation s'il a une autre convention de chemins. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="DOSSIERAPP" />
    <WixVariable Id="WixUILicenseRtf" Value="licence.rtf" />

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DOSSIERBASTION" Name="Bastion">
        <Directory Id="DOSSIERAPP" Name="StationBlanche" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="DOSSIERMENU" Name="Bastion" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Principal" Title="Station blanche" Level="1">
      <ComponentGroupRef Id="Composants" />
    </Feature>

    <ComponentGroup Id="Composants">

      <Component Directory="DOSSIERAPP" Guid="1C6D2F84-90B3-4A7E-8E15-3D9C7A2B6F40">
        <File Id="Executable" Source="..\publish\BastionStationBlanche.exe" KeyPath="yes" />

        <!-- Écriture pour le groupe Utilisateurs (S-1-5-32-545) : c'est la
             condition pour que l'écran de configuration puisse enregistrer
             station.json. Sans cela le logiciel s'installe et refuse d'être
             configuré — une panne qui se manifeste après coup, sur le poste. -->
        <!-- SDDL plutôt que des droits nommés : c'est ce qu'attend WiX 5.
             BA = administrateurs, SY = système, BU = groupe Utilisateurs.
             0x1301BF = « Modifier » : lire, écrire, créer et supprimer dans le
             dossier, sans pouvoir en changer les permissions. OICI propage aux
             fichiers et sous-dossiers. Les deux premières entrées sont
             indispensables : un SDDL REMPLACE la liste existante, et l'omettre
             enfermerait le dossier hors de portée des administrateurs. -->
        <CreateFolder>
          <PermissionEx Sddl="D:(A;OICI;FA;;;BA)(A;OICI;FA;;;SY)(A;OICI;0x1301BF;;;BU)" />
        </CreateFolder>

        <!-- Retire station.json à la désinstallation : il porte le jeton de la
             station, qui n'a rien à faire sur un poste rendu au parc. -->
        <RemoveFile Id="NettoyerConfig" Name="station.json" On="uninstall" />
      </Component>

      <Component Directory="DOSSIERMENU" Guid="4B8E1A57-2C0D-4F63-B9A8-6E5D3C1F7092">
        <Shortcut Id="RaccourciMenu"
                  Name="Bastion — Station blanche"
                  Description="Analyse des supports amovibles"
                  Target="[DOSSIERAPP]BastionStationBlanche.exe"
                  WorkingDirectory="DOSSIERAPP" />
        <RemoveFolder Id="NettoyerMenu" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\Bastion\StationBlanche"
                       Name="menu" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Directory="DesktopFolder" Guid="9A2F6C08-7D45-4E19-A3B6-1F8C4D0E5B27">
        <Shortcut Id="RaccourciBureau"
                  Name="Bastion — Station blanche"
                  Description="Analyse des supports amovibles"
                  Target="[DOSSIERAPP]BastionStationBlanche.exe"
                  WorkingDirectory="DOSSIERAPP" />
        <RegistryValue Root="HKCU" Key="Software\Bastion\StationBlanche"
                       Name="bureau" Type="integer" Value="1" KeyPath="yes" />
      </Component>

    </ComponentGroup>
  </Package>
</Wix>
