<Window x:Class="DockLite.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="380"
        SizeToContent="Height"
        FontFamily="Segoe UI">

    <Border CornerRadius="10"
            Padding="14"
            MouseLeftButtonUp="Border_MouseLeftButtonUp"
            Cursor="Hand">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F02A3F66" Offset="0"/>
                <GradientStop Color="#F0182640" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.7" Color="Black"/>
        </Border.Effect>
        <Border.BorderBrush>
            <SolidColorBrush Color="#5096E6"/>
        </Border.BorderBrush>
        <Border.BorderThickness>1</Border.BorderThickness>

        <DockPanel>
            <Grid DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Top">
                <Ellipse>
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#5096E6" Offset="0"/>
                            <GradientStop Color="#1E50AA" Offset="1"/>
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock Text="💬"
                           FontSize="20"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>

            <Button DockPanel.Dock="Right"
                    Content="✕"
                    Width="22" Height="22"
                    Padding="0"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    Foreground="#9BB6D9"
                    BorderThickness="0"
                    FontSize="11"
                    Cursor="Hand"
                    Click="CloseButton_Click"/>

            <StackPanel>
                <TextBlock x:Name="TitleText"
                           Text="Nouvelle réponse à votre ticket"
                           Foreground="White"
                           FontWeight="SemiBold"
                           FontSize="13"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="SubjectText"
                           Foreground="#9BB6D9"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,2,0,6"/>
                <TextBlock x:Name="BodyText"
                           Foreground="#E0E8F0"
                           FontSize="12"
                           TextWrapping="Wrap"
                           MaxHeight="60"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="MetaText"
                           Foreground="#7A8A9A"
                           FontSize="10"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
