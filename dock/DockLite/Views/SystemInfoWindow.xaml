<Window x:Class="DockLite.Views.SystemInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Informations machine"
        Icon="pack://application:,,,/Assets/DockPolice.ico"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Foreground="White"
        FontFamily="Segoe UI"
        ResizeMode="CanMinimize">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Foreground" Value="#9BB6D9"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Value">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Border Padding="20">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Image Source="pack://application:,,,/Assets/logo.png"
                       Width="56" Height="56"
                       Margin="0,0,14,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="DockPolice"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="White"/>
                    <TextBlock Text="Informations machine"
                               FontSize="12"
                               Foreground="#9BB6D9"/>
                </StackPanel>
            </StackPanel>

            <Grid x:Name="InfoGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
            </Grid>

            <!-- Bandeau "Extension Firefox" -->
            <Border x:Name="ExtFirefoxPanel"
                    Background="#1A2137"
                    BorderBrush="#2A3350"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,12"
                    Margin="0,18,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Width="36" Height="36" CornerRadius="9"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4E8BFF" Offset="0"/>
                                <GradientStop Color="#1E3A8A" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="🦊" FontSize="20"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Extension Firefox · Coffre-fort + 2FA"
                                   Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock x:Name="ExtSubText"
                                   Text="Installation et configuration automatiques pour ce poste"
                                   Foreground="#9BB6D9" FontSize="11" Margin="0,2,0,0"/>
                        <!-- Barre de progression (cachée par défaut) -->
                        <ProgressBar x:Name="ExtProgress"
                                     Visibility="Collapsed"
                                     Height="4" Margin="0,6,0,0"
                                     Minimum="0" Maximum="100" Value="0"
                                     Background="#2A3350"
                                     Foreground="#4E8BFF"
                                     BorderThickness="0"/>
                    </StackPanel>
                    <Button Grid.Column="2"
                            x:Name="InstallExtButton"
                            Content="Installer / configurer"
                            Padding="14,7"
                            Background="#4E8BFF"
                            Foreground="White"
                            BorderThickness="0"
                            Click="InstallExt_Click"
                            Cursor="Hand"
                            VerticalAlignment="Center"
                            MinWidth="180"/>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <Button x:Name="CopyButton"
                        Content="Copier"
                        Padding="14,6"
                        Margin="0,0,8,0"
                        Click="Copy_Click"/>
                <Button x:Name="CloseButton"
                        Content="Fermer"
                        Padding="14,6"
                        IsCancel="True"
                        Click="Close_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
