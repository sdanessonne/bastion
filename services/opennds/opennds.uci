# Bastion — OpenNDS, configuration UCI (/etc/config/opennds)
#
# IMPORTANT : sur Debian 13, le paquet opennds 10.3.1 lit sa configuration ICI
# (format UCI, comme sur OpenWrt), et NON dans le fichier « legacy »
# /etc/opennds/opennds.conf (qui est ignoré malgré son en-tête trompeur).
#
# Les placeholders __XXX__ sont substitués au déploiement.

config opennds 'ndsconfig'
	option enabled '1'

	# Interface LAN gérée par OpenNDS (doit posséder une IPv4).
	option gatewayinterface '__LAN_IF__'
	option gatewayname 'Bastion'

	# ── FAS (Forwarding Authentication Service) : notre portail PHP ──────────
	# fasport ≠ 80 : OpenNDS réserve le port 80 pour l'interception et refuse
	# qu'un FAS local l'utilise. Apache sert donc le portail sur 2080.
	option fas_secure_enabled '1'
	option faskey '__FAS_KEY__'
	option fasport '2080'
	option faspath '/portal/fas.php'
	option fasremoteip '__LAN_IP__'

	# binauth : script appelé à chaque connexion/déconnexion (quotas + journalisation).
	option binauth '/usr/lib/opennds/binauth_log.sh'

	# ── Accès des clients pré-authentifiés au routeur (chaîne ndsRTR) ────────
	# INDISPENSABLE : sans 'allow tcp port 2080', les clients ne peuvent PAS
	# joindre la page de login (OpenNDS n'ouvre pas le port du FAS local tout seul).
	list users_to_router 'allow tcp port 22'
	list users_to_router 'allow tcp port 53'
	list users_to_router 'allow udp port 53'
	list users_to_router 'allow udp port 67'
	# NTP (123) : un poste du domaine doit pouvoir synchroniser son heure AVANT toute
	# authentification au portail — sinon son horloge dérive, Kerberos échoue (écart > 5 min)
	# et plus aucune GPO ne s'applique. Même famille que le DNS et le DHCP : service
	# d'infrastructure nécessaire en amont de l'accès Internet.
	list users_to_router 'allow udp port 123'
	list users_to_router 'allow tcp port 2050'
	list users_to_router 'allow tcp port 2080'
	list users_to_router 'allow tcp port 2443'
	# 8443 : les POSTES DU DOMAINE appellent l'API de la console — remontée d'inventaire
	# et vignette de l'écran de connexion. Le port manquait à cette liste alors que les
	# scripts déposés sur les postes visent « https://<passerelle>:8443/api.php » depuis
	# le début : les appels étaient rejetés par ndsRTR, silencieusement, et l'inventaire
	# n'a jamais rien remonté. Ces appels portent un jeton qui n'ouvre QUE les deux
	# actions « poste.* » (voir $actionsPoste dans admin/api.php).
	# À SAVOIR : cela rend aussi la page de connexion de la console joignable depuis le
	# réseau des postes. C'était déjà le cas par 192.168.182.2, que la règle « tout vers
	# l'annuaire » laisse passer en entier ; la protection reste le mot de passe.
	list users_to_router 'allow tcp port 8443'
	list users_to_router 'allow udp port 69'
