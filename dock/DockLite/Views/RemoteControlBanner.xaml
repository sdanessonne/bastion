<Window x:Class="DockLite.Views.RemoteControlBanner"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        Height="44"
        Focusable="False"
        IsHitTestVisible="False">
    <Border CornerRadius="0" Padding="16,0">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#DC2626" Offset="0"/>
                <GradientStop Color="#B91C1C" Offset="0.5"/>
                <GradientStop Color="#DC2626" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Icône + pastille clignotante -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="LiveDot" Width="12" Height="12" Fill="White" Margin="0,0,10,0"/>
                <TextBlock Text="🖥️ PRISE EN MAIN À DISTANCE EN COURS"
                           Foreground="White" FontWeight="Bold" FontSize="13"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Info technicien -->
            <TextBlock Grid.Column="1" x:Name="TechInfo"
                       Foreground="White" FontSize="13" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>

            <!-- Message de droite -->
            <TextBlock Grid.Column="2"
                       Text="Votre écran est visible par le service informatique"
                       Foreground="#FFE0E0" FontSize="11"
                       VerticalAlignment="Center"/>
        </Grid>
    </Border>
</Window>
