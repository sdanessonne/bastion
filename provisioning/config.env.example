# ─────────────────────────────────────────────────────────────────────────────
# Bastion — configuration centrale
# Copiez ce fichier et adaptez-le à votre matériel AVANT de lancer install.sh.
# Les secrets vides seront générés automatiquement à l'installation.
# ─────────────────────────────────────────────────────────────────────────────

# --- Interfaces réseau ---
# WAN = côté Internet/fibre. LAN = côté clients à authentifier.
# Vérifiez les noms réels avec :  ip -br link
# (Sur la VM VirtualBox Debian 13 : enp0s3 = WAN/NAT, enp0s8 = LAN/intnet)
WAN_IF="enp0s3"
LAN_IF="enp0s8"

# --- Plan d'adressage du LAN ---
LAN_NET="192.168.182.0"
LAN_MASK="255.255.255.0"
LAN_CIDR="24"
LAN_IP="192.168.182.1"          # IP de la passerelle Bastion côté LAN
DHCP_START="192.168.182.10"
DHCP_END="192.168.182.254"
DHCP_LEASE="1h"

# --- DNS servis aux clients (dnsmasq écoute sur LAN_IP) ---
DNS_UPSTREAM_1="9.9.9.9"        # Quad9 (résolveur amont)
DNS_UPSTREAM_2="1.1.1.1"

# --- Portail captif ---
PORTAL_FQDN="portail.proxyfibre.lan"   # nom résolu vers LAN_IP pour la page de login
UAM_PORT="3990"                        # port d'écoute UAM de CoovaChilli
UAM_UIPORT="4990"

# --- Secrets (laisser vide => générés à l'installation, écrits dans /etc/proxyfibre/secrets.env) ---
RADIUS_SECRET=""               # secret entre CoovaChilli et FreeRADIUS
UAM_SECRET=""                  # secret UAM entre CoovaChilli et la page de login

# --- Base de données FreeRADIUS ---
DB_NAME="radius"
DB_USER="radius"
DB_PASS=""                     # généré si vide

# --- Utilisateur de test créé à l'installation (pour valider la Phase 1) ---
TEST_USER="demo"
TEST_PASS=""                   # compte de demonstration (laisser vide en production)

# --- Compte administrateur de la console (à changer en production) ---
ADMIN_USER="admin"
ADMIN_PASS=""                  # OBLIGATOIRE : mot de passe de la console (a definir avant deploiement)

# --- Accès au menu PXE (installation réseau) ---
# Le menu PXE est protégé par les IDENTIFIANTS ADMINISTRATEUR ci-dessus
# (ADMIN_USER / ADMIN_PASS, validés contre la table pf_admins).
# Aucun mot de passe PXE dédié n'est nécessaire.
