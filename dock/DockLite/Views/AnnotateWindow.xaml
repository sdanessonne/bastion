<Window x:Class="DockLite.Views.AnnotateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DockPolice — Annoter la capture"
        Background="#0B0F19" Foreground="#E6EAF2"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1A2137"/>
            <Setter Property="Foreground" Value="#E6EAF2"/>
            <Setter Property="BorderBrush" Value="#2A3350"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#4E8BFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="ColorBtn" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#121829" BorderBrush="#1F2640" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold">
                    <Run Text="🖍 Annoter la capture"/>
                    <Run Text="  —  " Foreground="#6C7690"/>
                    <Run Text="dessine pour mettre en évidence le problème" Foreground="#96A1C0" FontSize="12" FontWeight="Normal"/>
                </TextBlock>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource ColorBtn}" Click="Color_Click" Tag="#EF4444" Background="#EF4444" BorderBrush="White" ToolTip="Rouge"/>
                    <Button Style="{StaticResource ColorBtn}" Click="Color_Click" Tag="#FBBF24" Background="#FBBF24" ToolTip="Jaune"/>
                    <Button Style="{StaticResource ColorBtn}" Click="Color_Click" Tag="#10B981" Background="#10B981" ToolTip="Vert"/>
                    <Button Style="{StaticResource ColorBtn}" Click="Color_Click" Tag="#3B82F6" Background="#3B82F6" ToolTip="Bleu"/>
                    <Button Style="{StaticResource ColorBtn}" Click="Color_Click" Tag="#FFFFFF" Background="White" ToolTip="Blanc"/>
                    <Border Width="1" Background="#2A3350" Margin="10,4"/>
                    <Button Click="Thin_Click"   ToolTip="Trait fin">●</Button>
                    <Button Click="Thick_Click"  ToolTip="Trait épais" FontSize="20">⬤</Button>
                    <Border Width="1" Background="#2A3350" Margin="10,4"/>
                    <Button Click="Highlight_Click" ToolTip="Surligneur">🖍</Button>
                    <Button Click="Pen_Click" ToolTip="Stylo">✏</Button>
                    <Button Click="Eraser_Click"   ToolTip="Gomme">🩹</Button>
                    <Border Width="1" Background="#2A3350" Margin="10,4"/>
                    <Button Click="Undo_Click" ToolTip="Annuler le dernier trait">↶ Annuler</Button>
                    <Button Click="Clear_Click" ToolTip="Tout effacer">🗑 Effacer</Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#121829" BorderBrush="#1F2640" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#96A1C0" FontSize="12">
                    <Run Text="Astuce : "/>
                    <Run Text=" Ctrl+Z " FontFamily="Consolas" Background="#1A2137"/>
                    <Run Text=" pour annuler le dernier trait."/>
                </TextBlock>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Click="Cancel_Click" IsCancel="True">Annuler</Button>
                    <Button Style="{StaticResource PrimaryBtn}" Click="Validate_Click" IsDefault="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📤" Margin="0,0,6,0"/>
                            <TextBlock Text="Envoyer la capture annotée"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Background="#000" x:Name="CanvasHost">
            <Image x:Name="BgImage" Stretch="Uniform"/>
            <InkCanvas x:Name="Ink" Background="Transparent"
                       EditingMode="Ink"/>
        </Grid>
    </DockPanel>
</Window>
